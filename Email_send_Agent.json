    {
      "parameters": {
        "jsCode": "\nconst raw = $json.output;\n\nlet email;\n\nif (typeof raw === 'string') {\n  email = JSON.parse(raw);\n} else if (raw && typeof raw === 'object') {\n  email = raw;\n} else {\n  throw new Error('AI Agent did not return email JSON in the output field.');\n}\n\nif (!email.subject || !email.body) {\n  throw new Error('Email must contain both subject and body.');\n}\n\nreturn {\n  json: {\n    ...$json,\n    emailSubject: email.subject,\n    emailBody: email.body\n  }\n};\n"
      },
